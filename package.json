{
  "name": "biblia-rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Busca semantica e RAG sobre a Biblia (PT + grego + hebraico) com Postgres + pgvector.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U biblia -d biblia",
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "buscar": "tsx src/cli.ts",
    "ingest:pt": "tsx scripts/ingest-pt.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/groq": "^1.2.9",
    "@ai-sdk/openai": "^1.3.24",
    "@hono/node-server": "^1.14.3",
    "ai": "^4.3.19",
    "hono": "^4.8.5",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
