# Conexao com o Postgres (roda no Docker por padrao)
DATABASE_URL=postgres://biblia:biblia@localhost:5434/biblia

# Embeddings (OpenAI text-embedding-3-large reduzido a 1024 dims)
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024

# LLM para o modo RAG (Groq, plano free)
GROQ_API_KEY=gsk_...
LLM_MODEL=llama-3.3-70b-versatile

# Porta da API
PORT=3000
